PREDICTFUN_BASE_URL=https://api.predict.fun
PREDICTFUN_API_KEY=your_api_key_here
PREDICTFUN_API_SECRET=your_api_secret_here
PREDICTFUN_AUTH_HEADER=Authorization
PREDICTFUN_AUTH_PREFIX=Bearer
PREDICTFUN_SECRET_HEADER=X-API-SECRET
PREDICTFUN_MARKETS_PATH=/markets
PREDICTFUN_ORDERS_PATH=/orders
PREDICTFUN_POSITIONS_PATH=/positions
PREDICTFUN_BALANCE_PATH=/balance

BINANCE_BASE_URL=https://api.binance.com

BUDGET_TOTAL_USD=50
POSITION_SIZE_MIN_PCT=0.10
POSITION_SIZE_MAX_PCT=0.15
MAX_OPEN_POSITIONS=1
MIN_VOLUME_USD=50000
EDGE_THRESHOLD=0.04
TAKE_PROFIT_PCT=0.30
STOP_LOSS_PCT=0.15
EXIT_BEFORE_EXPIRY_MINUTES=5
MAX_TIME_TO_EXPIRY_MINUTES=1440
MIN_TIME_TO_EXPIRY_MINUTES=1

MODEL_K=10
MODEL_LOOKBACK_MINUTES=5
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
ALLOWED_RESOLUTIONS=15
ALLOWED_KINDS=UPDOWN

APPROVAL_MODE=file
APPROVAL_FILE_PATH=~/clawd-approvals.txt

TRADE_LOG_PATH=~/clawd-trades.log
PNL_LOG_PATH=~/clawd-pnl.log
PNL_REPORT_HOUR_UTC=0
PNL_REPORT_MINUTE_UTC=0

POLL_INTERVAL_SEC=15
DRY_RUN=true
