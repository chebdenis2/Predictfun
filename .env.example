PREDICTFUN_BASE_URL=https://api.predict.fun
PREDICTFUN_API_KEY=your_api_key_here
PREDICTFUN_API_KEY_HEADER=x-api-key
PREDICTFUN_AUTH_HEADER=Authorization
PREDICTFUN_JWT=
PREDICTFUN_AUTH_MODE=predict
PREDICTFUN_PRIVY_WALLET_PRIVATE_KEY=
PREDICTFUN_PREDICT_ACCOUNT_ADDRESS=
PREDICTFUN_WALLET_PRIVATE_KEY=
PREDICTFUN_CHAIN_ID=56
PREDICTFUN_SET_APPROVALS=false
PREDICTFUN_MARKETS_PATH=/v1/markets
PREDICTFUN_ORDERS_PATH=/v1/orders
PREDICTFUN_POSITIONS_PATH=/v1/positions
PREDICTFUN_BALANCE_PATH=/v1/account
PREDICTFUN_ORDERBOOK_PATH=/v1/markets/{id}/orderbook
PREDICTFUN_STATS_PATH=/v1/markets/{id}/stats
PREDICTFUN_AUTH_MESSAGE_PATH=/v1/auth/message
PREDICTFUN_AUTH_PATH=/v1/auth
PREDICTFUN_MAX_PAGES=5
PREDICTFUN_MARKETS_PAGE_SIZE=50
PREDICTFUN_PAGE_SLEEP_SEC=0.35
PREDICTFUN_MAX_PAGE_ERRORS=2
PREDICTFUN_MARKETS_STATUSES=
PREDICTFUN_MARKETS_SOURCE=rest
PREDICTFUN_GRAPHQL_URL=https://graphql.predict.fun/graphql
PREDICTFUN_GRAPHQL_IS_RESOLVED=false
MARKETS_CURSOR_TTL_SEC=900
ORDERBOOK_RETRY_COUNT=2
ORDERBOOK_RETRY_SLEEP_SEC=0.6
ORDERBOOK_SOURCE=rest
WS_ORDERBOOK_URL=wss://ws.predict.fun/ws
WS_ORDERBOOK_SNAPSHOT_SEC=6
WS_ORDERBOOK_MAX_TOPICS=50
WS_ORDERBOOK_BATCH_SLEEP_SEC=0.2

BINANCE_BASE_URL=https://api.binance.com

BUDGET_TOTAL_USD=50
POSITION_SIZE_MIN_PCT=0.10
POSITION_SIZE_MAX_PCT=0.15
MAX_OPEN_POSITIONS=1
MIN_VOLUME_USD=5000
EDGE_THRESHOLD=0.02
TAKE_PROFIT_PCT=0.30
STOP_LOSS_PCT=0.15
EXIT_BEFORE_EXPIRY_MINUTES=5
MAX_TIME_TO_EXPIRY_MINUTES=1440
MIN_TIME_TO_EXPIRY_MINUTES=1
ORDER_EXPIRY_MINUTES=10
MAX_SPREAD=0.05
MIN_EXPECTED_ROI=0.02
FEE_EDGE_MULTIPLIER=2.0

MODEL_K=10
MODEL_LOOKBACK_MINUTES=5
SPOT_WEIGHT=0.6
SPOT_SENSITIVITY=10
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
ALLOWED_RESOLUTIONS=15
ALLOWED_KINDS=YESNO,UPDOWN,BINARY
ALLOWED_STATUSES=UNPAUSED,PRICE_PROPOSED,REGISTERED

APPROVAL_MODE=file
APPROVAL_FILE_PATH=~/clawd-approvals.txt

TRADE_LOG_PATH=~/clawd-trades.log
PNL_LOG_PATH=~/clawd-pnl.log
PNL_REPORT_HOUR_UTC=0
PNL_REPORT_MINUTE_UTC=0

STRATEGY_MODE=edge
POLL_INTERVAL_SEC=15
DRY_RUN=true
VERBOSE_LOGS=false
LOG_REJECTIONS=true

# Farm strategy settings
## For farm, you can allow all symbols by setting ALLOWED_SYMBOLS=*
# ALLOWED_SYMBOLS=*
# ALLOWED_RESOLUTIONS=
FARM_MIN_SPREAD=0.01
FARM_MAX_SPREAD=0.02
FARM_MIN_HOLD_SEC=300
FARM_MIN_VOLUME_USD=50000
FARM_MAX_VOLUME_USD=150000
FARM_ORDER_USD=5
FARM_ORDER_USD_MIN=4
FARM_ORDER_USD_MAX=12
FARM_MAX_INVENTORY_USD=12
FARM_ALLOW_POSITION_ADD=false
FARM_MAX_OPEN_MARKETS=3
FARM_AVOID_MINUTES=15
FARM_MAX_VOLATILITY=0.02
FARM_VOL_SAMPLES=6
FARM_TOP_LEVELS=5
FARM_ORDER_EXPIRY_MINUTES=5
FARM_ORDER_EXPIRY_MAX_MINUTES=10
FARM_STOP_LOSS_PCT=0.30
FARM_STOP_LOSS_EXPIRY_MINUTES=2
FARM_AUTO_RELAX=true
